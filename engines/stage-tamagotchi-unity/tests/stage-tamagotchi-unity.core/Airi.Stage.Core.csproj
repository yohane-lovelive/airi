<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Unity compiles Assets/Airi/Core against .NET Standard 2.1 with C# 9. This build fails on the same limits. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Airi.Stage.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Airi\Core\**\*.cs" LinkBase="Core" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
