# The OpenAI-compatible endpoint of OpenCode Go, as in the provider settings of AIRI.
AUTONOMY_REPLAY_BASE_URL=''
AUTONOMY_REPLAY_API_KEY=''
# Comma-separated speaking models. Each model replays every recording.
AUTONOMY_REPLAY_MODELS='gpt-6-luna'
# Body fields for each model, as JSON. The provider of the app turns reasoning off this way for autonomous speech.
AUTONOMY_REPLAY_REQUEST_FIELDS='{"gpt-6-luna":{"reasoningEffort":"none"}}'
# The most output tokens of one model request. Empty sets no limit, as the app.
AUTONOMY_REPLAY_MAX_OUTPUT_TOKENS=''
# A request-start.json of the app, for every recording. Empty uses the file of each recording, or a short persona.
AUTONOMY_REPLAY_REQUEST_START=''
# The judge model. Empty uses the first speaking model.
AUTONOMY_REPLAY_JUDGE_MODEL=''
# The folder that holds the recordings. Empty uses the recordings folder of the desktop app.
AUTONOMY_REPLAY_RECORDINGS=''
# idle or commentary.
AUTONOMY_REPLAY_MODE='idle'
# Comma-separated frame policies: fresh-keyframes, contact-sheet, scene-anchor, scene-anchor+contact-sheet, recent-sheet.
# Empty runs recent-sheet, the policy of a commentary turn of the app.
AUTONOMY_REPLAY_POLICIES=''
# The owner's player names in games, as "game: name" parts with a semicolon between them, for example
# 'League of Legends: somename'. The app reads them from the memories of the character. With them, the model can tell
# which character on a loading screen is the owner's.
AUTONOMY_REPLAY_OWNER_ACCOUNTS=''
# The key of the Gemini API, for the looks of the decision model. The gate trace (eval:gate) needs it. With it, a
# replay in the commentary mode also looks at the screen, and a roster screen starts a cast read. The looks of a
# recording are saved in its folder.
GEMINI_API_KEY=''
# 'off' runs a replay without the looks, although the key is set.
AUTONOMY_REPLAY_LOOKS=''
