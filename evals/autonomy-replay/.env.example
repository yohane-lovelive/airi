# The OpenAI-compatible endpoint of OpenCode Go, as in the provider settings of AIRI.
AUTONOMY_REPLAY_BASE_URL=''
AUTONOMY_REPLAY_API_KEY=''
# Comma-separated speaking models. Each model replays every recording.
AUTONOMY_REPLAY_MODELS='deepseek-v4.1-flash'
# The judge model. Empty uses the first speaking model.
AUTONOMY_REPLAY_JUDGE_MODEL=''
# The folder that holds the recordings. Empty uses the recordings folder of the desktop app.
AUTONOMY_REPLAY_RECORDINGS=''
# idle or commentary.
AUTONOMY_REPLAY_MODE='idle'
